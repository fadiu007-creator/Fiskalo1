{
  "expo": {
    "name": "Fiskalo POS",
    "slug": "fiskalo-pos",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.fiskalo.pos",
      "versionCode": 1,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN"
      ],
      "blockedPermissions": [],
      "usesFeatures": [{ "name": "android.hardware.usb.host", "required": false }],
      "usesCleartextTraffic": false
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
