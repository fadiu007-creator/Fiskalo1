  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.29",
    "typescript": "5.9.2",
    "@eslint/eslintrc": "3.3.1",
    "@opennextjs/cloudflare": "1.20.16",
